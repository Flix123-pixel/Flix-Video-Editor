*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial,sans-serif;
}

html,
body{
    width:100%;
    height:100%;
    background:#08090d;
    color:#fff;
    overflow:hidden;
}

button{
    border:0;
    border-radius:8px;
    padding:9px 13px;
    background:#20232d;
    color:#fff;
    cursor:pointer;
    font-size:14px;
}

button:hover{
    background:#343846;
}

button:active{
    transform:scale(.97);
}

.app{
    width:100%;
    height:100vh;
    display:flex;
    flex-direction:column;
}

.topbar{
    height:60px;
    min-height:60px;
    background:#11131a;
    border-bottom:1px solid #292d38;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 15px;
}

.logo{
    font-size:20px;
    font-weight:bold;
    color:#756cff;
    white-space:nowrap;
}

.logo span{
    color:#fff;
}

.top-buttons,
.top-actions{
    display:flex;
    gap:7px;
}

.import-btn{
    background:#252936;
}

.export,
.export-btn{
    background:#6c63ff;
}

.editor,
.main{
    flex:1;
    min-height:0;
    display:flex;
}

.left-panel{
    width:78px;
    min-width:78px;
    background:#101218;
    border-right:1px solid #292d38;
    padding:8px;
    overflow-y:auto;
}

.tool{
    width:100%;
    margin-bottom:8px;
    padding:10px 3px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:5px;
    background:#181b23;
    border-radius:8px;
    cursor:pointer;
    user-select:none;
}

.tool:hover{
    background:#282c38;
}

.tool.active{
    background:#6c63ff;
}

.tool strong,
.tool b{
    font-size:16px;
}

.tool span,
.tool small{
    font-size:10px;
    color:#b7bac5;
}

.media-panel{
    width:230px;
    min-width:230px;
    background:#12141b;
    border-right:1px solid #292d38;
}

.panel-header{
    padding:17px;
    border-bottom:1px solid #292d38;
}

.panel-header h2{
    font-size:18px;
}

#panelContent{
    padding:15px;
}

.big-import{
    width:100%;
    padding:14px;
    background:#6c63ff;
}

.hint{
    margin-top:12px;
    color:#858a98;
    font-size:12px;
    line-height:1.5;
}

.center,
.workspace{
    flex:1;
    min-width:0;
    min-height:0;
    display:flex;
    flex-direction:column;
}

.preview-area,
.preview{
    flex:1;
    min-height:0;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#050609;
    position:relative;
    overflow:hidden;
}

.preview-container{
    width:min(80%,850px);
    height:80%;
    display:flex;
    justify-content:center;
    align-items:center;
    position:relative;
}

#previewVideo,
.preview video{
    max-width:100%;
    max-height:100%;
    background:#000;
    border-radius:4px;
    display:none;
}

.empty-preview,
.empty{
    position:absolute;
    text-align:center;
    color:#777c89;
    pointer-events:none;
}

.empty-preview div{
    font-size:45px;
    margin-bottom:10px;
}

.empty-preview h2,
.empty h2{
    color:#bfc2cc;
    margin-bottom:6px;
}

.empty-preview p,
.empty p{
    color:#777c89;
}

.text-overlay,
.text-layer{
    position:absolute;
    font-size:40px;
    font-weight:bold;
    color:#fff;
    text-shadow:2px 2px 8px #000;
    pointer-events:none;
    display:none;
    z-index:10;
    max-width:80%;
    text-align:center;
}

.player-controls,
.controls{
    height:55px;
    min-height:55px;
    display:flex;
    align-items:center;
    gap:10px;
    padding:8px 14px;
    background:#11131a;
    border-top:1px solid #292d38;
}

.player-controls input,
.controls input{
    flex:1;
    min-width:70px;
}

#currentTime,
#totalTime,
#time{
    color:#bbb;
    font-size:13px;
    white-space:nowrap;
}

.timeline{
    height:210px;
    min-height:210px;
    background:#0d0f14;
    border-top:1px solid #292d38;
    overflow:hidden;
}

.timeline-toolbar{
    height:45px;
    display:flex;
    align-items:center;
    gap:7px;
    padding:6px 12px;
    border-bottom:1px solid #292d38;
}

.timeline-ruler{
    height:25px;
    display:flex;
    justify-content:space-around;
    align-items:center;
    color:#777c89;
    font-size:10px;
}

.tracks{
    padding:5px 10px;
    overflow:auto;
}

.track-label{
    height:16px;
    font-size:9px;
    color:#777c89;
}

.track{
    height:42px;
    margin-bottom:7px;
    background:#171a21;
    border-radius:6px;
    position:relative;
    overflow:hidden;
}

.timeline-clip{
    position:absolute;
    left:5px;
    top:4px;
    bottom:4px;
    width:45%;
    min-width:120px;
    border-radius:5px;
    background:#5f57e8;
    display:flex;
    align-items:center;
    padding:0 12px;
    overflow:hidden;
    white-space:nowrap;
    font-size:12px;
}

.trim-left,
.trim-right{
    position:absolute;
    top:0;
    bottom:0;
    width:7px;
    background:#fff;
    cursor:ew-resize;
}

.trim-left{
    left:0;
}

.trim-right{
    right:0;
}

.text-clip{
    position:absolute;
    left:5px;
    top:5px;
    bottom:5px;
    width:30%;
    min-width:90px;
    background:#d68c28;
    border-radius:5px;
    display:flex;
    align-items:center;
    padding-left:10px;
    overflow:hidden;
    white-space:nowrap;
}

.properties{
    width:250px;
    min-width:250px;
    background:#101218;
    border-left:1px solid #292d38;
    padding:15px;
    overflow:auto;
}

.properties h2{
    font-size:18px;
    margin-bottom:20px;
}

.property{
    margin-bottom:20px;
}

.property label{
    display:block;
    font-size:12px;
    color:#999eac;
    margin-bottom:7px;
}

.property input,
.property select{
    width:100%;
    background:#1a1d25;
    color:#fff;
    border:1px solid #303440;
    border-radius:6px;
    padding:8px;
}

input[type="range"]{
    accent-color:#756cff;
    padding:0;
}

input[type="text"]{
    outline:none;
}

input[type="text"]:focus,
select:focus{
    border-color:#6c63ff;
}

@media(max-width:900px){

    .media-panel{
        width:180px;
        min-width:180px;
    }

    .properties{
        width:200px;
        min-width:200px;
    }
}

@media(max-width:700px){

    .media-panel,
    .properties{
        display:none;
    }

    .left-panel{
        width:60px;
        min-width:60px;
    }

    .project-name{
        display:none;
    }

    .logo{
        font-size:15px;
    }

    .topbar{
        padding:0 8px;
    }

    .top-buttons button,
    .top-actions button{
        padding:7px 8px;
        font-size:11px;
    }

    .timeline{
        height:170px;
        min-height:170px;
    }
}
